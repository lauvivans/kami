{
  "name": "@lauvivans/kami",
  "version": "2.0.9",
  "description": "A Notion-based portfolio",
  "type": "module",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "notion",
    "portfolio",
    "cms"
  ],
  "author": "Laura Vivan",
  "bin": {
    "create-kami": "bin/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pkg": "vue-tsc -b && vite build --config vite.config.package.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "node ./bin/cli.js",
    "format": "npx prettier --write .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepare": "husky",
    "lint:css": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss,vue}\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lauvivans/kami.git"
  },
  "bugs": {
    "url": "https://github.com/lauvivans/kami/issues"
  },
  "homepage": "https://github.com/lauvivans/kami#readme",
  "files": [
    "dist",
    "bin",
    "template",
    "README.md",
    "License"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write",
      "vitest related --run --passWithNoTests"
    ],
    "*.{css,scss}": "stylelint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^5.0.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "flatted": "^3.4.4",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "sass": "^1.108.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "pinia": "^4.0.0",
    "vue": "^3.5.11",
    "vue-router": "^4.0.0 || ^5.0.0"
  }
}
